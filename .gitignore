# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configurations
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.tmp.*
.env
.env.local

# Project Specific Exclusions:
# 1. PDF files (guidelines, project details, documentation PDFs)
*.pdf
# ...except the team's project reference docs
!docs/*.pdf

# Final project evaluation reports and build scripts (kept local, not pushed to git)
reports/FINAL_PROJECT_REPORT_*
reports/build_pdf_report.py

# 2. Generated figures (rebuilt by the scripts)
figures/**/*.png
*.png
!milestone 2/outputs/*.png

# 3. Model artifacts and experiment tracking
mlruns/
*.pkl
*.joblib
catboost_info/
